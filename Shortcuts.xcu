<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keyboard shortcuts for the remaining Markdown Writer commands.

  Ctrl+Alt+<key> combinations were chosen to avoid clashing with the built-in
  Writer shortcuts (MOD1 = Ctrl, MOD2 = Alt on Linux/Windows).
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Accelerators"
                    oor:package="org.openoffice.Office">

  <node oor:name="PrimaryKeys">
    <node oor:name="Modules">
      <node oor:name="com.sun.star.text.TextDocument" oor:op="fuse">

        <node oor:name="P_MOD1_MOD2" oor:op="replace">
          <prop oor:name="Command" oor:type="xs:string">
            <value>org.sendyyeah.mdwriter:preview</value>
          </prop>
        </node>

        <node oor:name="M_MOD1_MOD2" oor:op="replace">
          <prop oor:name="Command" oor:type="xs:string">
            <value>org.sendyyeah.mdwriter:source</value>
          </prop>
        </node>

      </node>
    </node>
  </node>

</oor:component-data>
