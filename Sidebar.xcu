<?xml version="1.0" encoding="UTF-8"?>
<!--
  Custom sidebar deck "Markdown" with one panel: the Markdown source editor.

  * Content/DeckList    : the deck
  * Content/PanelList   : the panel, bound to the deck and to a factory URL
  * Registered/ContentFactories : our com.sun.star.ui.XUIElementFactory, which
    creates the panel (Type "toolpanel").
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Sidebar"
                    oor:package="org.openoffice.Office.UI">

  <node oor:name="Content">

    <node oor:name="DeckList">
      <node oor:name="com.sendyyeah.mdwriter.Deck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Markdown</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>MarkdownDeck</value>
        </prop>
        <prop oor:name="ContextList" oor:type="oor:string-list">
          <value>com.sun.star.text.TextDocument</value>
          <value>com.sun.star.text.GlobalDocument</value>
          <value>com.sun.star.text.WebDocument</value>
        </prop>
      </node>
    </node>

    <node oor:name="PanelList">
      <node oor:name="com.sendyyeah.mdwriter.Panel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Markdown Source</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>MarkdownSourcePanel</value>
        </prop>
        <prop oor:name="DeckId" oor:type="xs:string">
          <value>MarkdownDeck</value>
        </prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string">
          <value>private:resource/toolpanel/com.sendyyeah.mdwriter/Source</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int">
          <value>100</value>
        </prop>
        <prop oor:name="ShowForReadOnlyDocument" oor:type="xs:boolean">
          <value>false</value>
        </prop>
        <prop oor:name="ContextList" oor:type="oor:string-list">
          <value>com.sun.star.text.TextDocument</value>
          <value>com.sun.star.text.GlobalDocument</value>
          <value>com.sun.star.text.WebDocument</value>
        </prop>
      </node>
    </node>

  </node>

</oor:component-data>
