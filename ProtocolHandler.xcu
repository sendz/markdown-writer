<?xml version="1.0" encoding="UTF-8"?>
<!--
  Register our component as the protocol handler for the custom URL scheme
  "org.sendyyeah.mdwriter:". Menu/toolbar commands then go straight to our
  XDispatchProvider/XDispatch (instead of com.sun.star.comp.framework
  .ServiceHandler), which lets us report command state - that is what turns
  "Toggle Live Markdown" into a real check box.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="ProtocolHandler"
                    oor:package="org.openoffice.Office">

  <node oor:name="HandlerSet">
    <node oor:name="com.sendyyeah.mdwriter.Dispatch" oor:op="replace">
      <prop oor:name="Protocols" oor:type="oor:string-list">
        <value>org.sendyyeah.mdwriter:*</value>
      </prop>
    </node>
  </node>

</oor:component-data>
