<?xml version="1.0" encoding="UTF-8"?>
<!--
  Best-effort automatic start-up hook.  When the office runs job components for
  document events, "com.sendyyeah.mdwriter.Job" installs the live Markdown
  formatter on the opened document.  Live mode also gets enabled the first time
  any Markdown Writer command is used, so the feature works even where the
  office does not run this job.

  Modelled on the built-in "org.libreoffice.PresenterScreen" job.  Note that
  the JobList set and its entries must NOT carry an oor:op attribute.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Jobs"
                    oor:package="org.openoffice.Office">

  <node oor:name="Jobs">
    <node oor:name="MarkdownWriterListener" oor:op="replace">
      <prop oor:name="Service" oor:type="xs:string">
        <value>com.sendyyeah.mdwriter.Job</value>
      </prop>
      <prop oor:name="Context" oor:type="xs:string">
        <value>com.sun.star.text.TextDocument</value>
      </prop>
    </node>
  </node>

  <node oor:name="Events">
    <node oor:name="onDocumentOpened" oor:op="fuse">
      <node oor:name="JobList">
        <node oor:name="MarkdownWriterListener"/>
      </node>
    </node>
  </node>

</oor:component-data>
